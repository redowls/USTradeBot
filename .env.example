# Copy to ".env" and fill in. .env is gitignored — never commit real keys.

# --- Secrets (required) ---
# Alpaca PAPER keys: https://app.alpaca.markets  (Home -> generate Paper keys)
ALPACA_KEY_ID=
ALPACA_SECRET=
# Telegram: create a bot with @BotFather for the token, then message it and
# read getUpdates for your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alpaca endpoints (paper only — do not point at live) ---
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Free tier uses the IEX feed (SIP is a paid upgrade).
ALPACA_DATA_FEED=iex

# --- Strategy tunables (dual-timeframe EMA ribbons) ---
WATCHLIST=NFLX,BIRD,WPM
# Trigger timeframe (1-min ribbon) and gate timeframe (5-min ribbon).
CANDLE_INTERVAL=1m
LONG_CANDLE_INTERVAL=5m
# 1-min trigger ribbon: fast,mid,slow EMA periods.
SHORT_MA_PERIODS=8,10,20
# 5-min gate ribbon: fast,mid,slow EMA periods.
LONG_MA_PERIODS=21,34,55
RSI_PERIOD=14
# Lookback for the trailing average-volume confirmation baseline (1-min).
VOLUME_MA_PERIOD=20
# ATR lookback for the volatility sub-score (1-min).
ATR_PERIOD=14
ENTRY_THRESHOLD=60

# --- Position sizing ---
# A = % of buying power (default); B = risk budget from the stop distance.
SIZING_MODEL=A
# Model A: wallet fraction at the entry threshold (MIN) up to confidence 100 (MAX).
# Keep MAX small relative to the watchlist size so the budget spreads across names
# instead of a few early crosses eating all the buying power (first-come-first-served).
MIN_ALLOC=0.05
MAX_ALLOC=0.10
# Model B (optional): max fraction of equity risked per trade; MAX_ALLOC caps notional.
MAX_RISK_PER_TRADE=0.02

# --- Bracket levels (fractions: 0.02 = 2%) ---
STOP_LOSS=0.02
# Target acts as a wide ceiling now that the trailing stop is the primary exit.
TAKE_PROFIT=0.10
# Trailing stop: once in profit, ratchet the broker stop to price*(1-TRAIL_PERCENT)
# each candle (never down), so winners run and give back at most this from the peak.
TRAIL_PERCENT=0.02

# --- Market hours (US Eastern, 24h HH:MM) ---
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
# Intraday flatten: within this many minutes of the close, flatten all positions
# and open nothing new, so nothing carries overnight (the bracket's DAY stop/target
# legs expire at the close). Set 0 to disable. Default 5.
FLATTEN_BEFORE_CLOSE_MIN=5

# --- SQL Server (Phase 6) ---
# pyodbc connection string. Driver 18 encrypts by default; TrustServerCertificate=yes
# accepts a self-signed cert. Leave empty to disable persistence (the bot still trades).
# SQLSERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=host;DATABASE=USBot;UID=sa;PWD=secret;Encrypt=yes;TrustServerCertificate=yes
SQLSERVER_CONN=

# --- Logging ---
LOG_LEVEL=INFO
