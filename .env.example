# Copy to ".env" and fill in. .env is gitignored — never commit real keys.

# --- Secrets (required) ---
# Alpaca PAPER keys: https://app.alpaca.markets  (Home -> generate Paper keys)
ALPACA_KEY_ID=
ALPACA_SECRET=
# Telegram: create a bot with @BotFather for the token, then message it and
# read getUpdates for your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alpaca endpoints (paper only — do not point at live) ---
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Free tier uses the IEX feed (SIP is a paid upgrade).
ALPACA_DATA_FEED=iex

# --- Strategy tunables ---
WATCHLIST=NFLX,BIRD,WPM
CANDLE_INTERVAL=1m
FAST_MA_PERIOD=9
SLOW_MA_PERIOD=21
TREND_MA_PERIOD=50
RSI_PERIOD=14
ENTRY_THRESHOLD=60

# --- Position sizing (Model A) ---
MIN_ALLOC=0.10
MAX_ALLOC=0.40
# --- Position sizing (Model B, optional) ---
MAX_RISK_PER_TRADE=0.02

# --- Bracket levels (fractions: 0.02 = 2%) ---
STOP_LOSS=0.02
TAKE_PROFIT=0.04

# --- Market hours (US Eastern, 24h HH:MM) ---
MARKET_OPEN=09:30
MARKET_CLOSE=16:00

# --- SQL Server (Phase 6) ---
SQLSERVER_CONN=

# --- Logging ---
LOG_LEVEL=INFO
